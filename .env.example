MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=personal_finance
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_PORT=3306
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:3010

# Clerk — create an application at https://dashboard.clerk.com
# Set "Email address" and optionally Google/GitHub OAuth in the dashboard
CLERK_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE
CLERK_SECRET_KEY=sk_test_YOUR_KEY_HERE

# Clerk webhook signing secret — from Clerk Dashboard > Webhooks > endpoint > Signing Secret
# For local dev: use the ngrok overlay (docker-compose.ngrok.yml) to expose a tunnel URL.
# Register endpoint URL: https://<tunnel-id>.ngrok.io/api/webhooks/clerk
# Subscribe to events: user.created, user.deleted
# Optional — server runs without it; JIT provisioning covers user.created locally.
CLERK_WEBHOOK_SECRET=whsec_YOUR_SECRET_HERE

# ngrok auth token — https://dashboard.ngrok.com/authtokens
# Required only when running docker-compose.ngrok.yml
NGROK_AUTHTOKEN=
